{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "lib": ["dom", "ES2021"],
    "skipLibCheck": true,
    "strictNullChecks": true,
    "sourceMap": true,
    "module": "CommonJS",
    "target": "ESNext",
    "strict": true,
    "esModuleInterop": true
  },
  // Також рекомендую виправити 'include', щоб він відповідав 'rootDir'
  "include": ["src/**/*.ts"]
}
